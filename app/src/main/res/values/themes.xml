<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — minimal shell; all real theming is in WingmanTheme (Compose) -->
    <!-- Fullscreen flags are applied programmatically in MainActivity via WindowInsetsControllerCompat -->
    <style name="Theme.Wingman" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
